import json, os

path = "/mnt/data/Task_2_Feature_Engineering_Model_Optimization.ipynb"

def M(s): return {"cell_type":"markdown","metadata":{},"source":s.strip().splitlines(True)}
def C(s): return {"cell_type":"code","execution_count":None,"metadata":{},"outputs":[],"source":s.strip().splitlines(True)}

cells = [
M("""# California Housing Price Prediction — Task 2
## Feature Engineering, Model Optimization & Performance Comparison

This notebook extends the California Housing Price Prediction project with feature engineering, feature scaling, regression models, hyperparameter optimization, and performance comparison.

**Models:** Linear Regression, Ridge Regression, Decision Tree Regressor  
**Metrics:** MAE, RMSE, R²"""),

M("""## 1. Import Required Libraries"""),
C("""import os
import warnings
warnings.filterwarnings("ignore")

import numpy as np
import pandas as pd
import matplotlib.pyplot as plt
import seaborn as sns
import joblib

from sklearn.datasets import fetch_california_housing
from sklearn.model_selection import train_test_split, GridSearchCV
from sklearn.preprocessing import StandardScaler
from sklearn.pipeline import Pipeline
from sklearn.linear_model import LinearRegression, Ridge
from sklearn.tree import DecisionTreeRegressor
from sklearn.metrics import mean_absolute_error, mean_squared_error, r2_score

pd.set_option("display.max_columns", None)
sns.set_theme(style="whitegrid")"""),

M("""## 2. Load the California Housing Dataset"""),
C("""housing = fetch_california_housing(as_frame=True)
df = housing.frame.copy()

print("Dataset shape:", df.shape)
display(df.head())"""),

M("""## 3. Dataset Inspection"""),
C("""print("Columns:")
print(df.columns.tolist())

print("\\nMissing values:")
display(df.isnull().sum())

print("\\nDescriptive statistics:")
display(df.describe())"""),

M("""## 4. Exploratory Data Analysis
### Correlation Heatmap"""),
C("""plt.figure(figsize=(11, 8))
sns.heatmap(df.corr(), annot=True, fmt=".2f", cmap="coolwarm")
plt.title("Correlation Heatmap — California Housing")
plt.tight_layout()
plt.show()"""),

M("""### Feature Distributions"""),
C("""df.hist(figsize=(14, 12), bins=30, edgecolor="black")
plt.suptitle("Feature Distributions", fontsize=16)
plt.tight_layout()
plt.show()"""),

M("""## 5. Feature Engineering

Two engineered features are created:
- `RoomsPerPerson = AveRooms / AveOccup`
- `BedroomsPerRoom = AveBedrms / AveRooms`"""),
C("""df_fe = df.copy()

df_fe["RoomsPerPerson"] = df_fe["AveRooms"] / df_fe["AveOccup"].replace(0, np.nan)
df_fe["BedroomsPerRoom"] = df_fe["AveBedrms"] / df_fe["AveRooms"].replace(0, np.nan)

df_fe.replace([np.inf, -np.inf], np.nan, inplace=True)
df_fe.dropna(inplace=True)

print("Shape after feature engineering:", df_fe.shape)
display(df_fe.head())"""),

M("""## 6. Define Features and Target"""),
C("""X = df_fe.drop(columns=["MedHouseVal"])
y = df_fe["MedHouseVal"]

print("Features:", X.columns.tolist())
print("X shape:", X.shape)
print("y shape:", y.shape)"""),

M("""## 7. Train-Test Split
An 80/20 split with `random_state=42` is used for reproducibility."""),
C("""X_train, X_test, y_train, y_test = train_test_split(
    X, y, test_size=0.20, random_state=42
)

print("Training samples:", len(X_train))
print("Testing samples:", len(X_test))"""),

M("""## 8. Feature Scaling

`StandardScaler` is applied through model pipelines to avoid data leakage."""),
C("""scaler = StandardScaler()
X_train_scaled = scaler.fit_transform(X_train)
X_test_scaled = scaler.transform(X_test)
print("Feature scaling completed.")"""),

M("""## 9. Linear Regression — Baseline"""),
C("""linear_pipeline = Pipeline([
    ("scaler", StandardScaler()),
    ("model", LinearRegression())
])

linear_pipeline.fit(X_train, y_train)
linear_pred = linear_pipeline.predict(X_test)

linear_mae = mean_absolute_error(y_test, linear_pred)
linear_rmse = np.sqrt(mean_squared_error(y_test, linear_pred))
linear_r2 = r2_score(y_test, linear_pred)

print(f"MAE  : {linear_mae:.4f}")
print(f"RMSE : {linear_rmse:.4f}")
print(f"R²   : {linear_r2:.4f}")"""),

M("""## 10. Ridge Regression — Hyperparameter Optimization

`GridSearchCV` with 5-fold cross-validation is used to select the best `alpha`."""),
C("""ridge_pipeline = Pipeline([
    ("scaler", StandardScaler()),
    ("model", Ridge())
])

ridge_param_grid = {
    "model__alpha": [0.01, 0.1, 1, 10, 100]
}

ridge_grid = GridSearchCV(
    ridge_pipeline,
    ridge_param_grid,
    cv=5,
    scoring="neg_root_mean_squared_error",
    n_jobs=-1
)

ridge_grid.fit(X_train, y_train)
best_ridge = ridge_grid.best_estimator_
ridge_pred = best_ridge.predict(X_test)

ridge_mae = mean_absolute_error(y_test, ridge_pred)
ridge_rmse = np.sqrt(mean_squared_error(y_test, ridge_pred))
ridge_r2 = r2_score(y_test, ridge_pred)

print("Best parameters:", ridge_grid.best_params_)
print(f"Best CV RMSE: {-ridge_grid.best_score_:.4f}")
print(f"Test MAE  : {ridge_mae:.4f}")
print(f"Test RMSE : {ridge_rmse:.4f}")
print(f"Test R²   : {ridge_r2:.4f}")"""),

M("""## 11. Decision Tree Regressor — Hyperparameter Optimization"""),
C("""tree = DecisionTreeRegressor(random_state=42)

tree_param_grid = {
    "max_depth": [5, 10, 15, 20, None],
    "min_samples_split": [2, 5, 10]
}

tree_grid = GridSearchCV(
    tree,
    tree_param_grid,
    cv=5,
    scoring="neg_root_mean_squared_error",
    n_jobs=-1
)

tree_grid.fit(X_train, y_train)
best_tree = tree_grid.best_estimator_
tree_pred = best_tree.predict(X_test)

tree_mae = mean_absolute_error(y_test, tree_pred)
tree_rmse = np.sqrt(mean_squared_error(y_test, tree_pred))
tree_r2 = r2_score(y_test, tree_pred)

print("Best parameters:", tree_grid.best_params_)
print(f"Best CV RMSE: {-tree_grid.best_score_:.4f}")
print(f"Test MAE  : {tree_mae:.4f}")
print(f"Test RMSE : {tree_rmse:.4f}")
print(f"Test R²   : {tree_r2:.4f}")"""),

M("""## 12. Performance Comparison
Lower MAE/RMSE is better; higher R² is better."""),
C("""results = pd.DataFrame({
    "Model": ["Linear Regression", "Ridge Regression", "Decision Tree Regressor"],
    "MAE": [linear_mae, ridge_mae, tree_mae],
    "RMSE": [linear_rmse, ridge_rmse, tree_rmse],
    "R2": [linear_r2, ridge_r2, tree_r2]
}).sort_values("RMSE").reset_index(drop=True)

display(results)"""),

M("""## 13. Select the Best Model"""),
C("""model_objects = {
    "Linear Regression": linear_pipeline,
    "Ridge Regression": best_ridge,
    "Decision Tree Regressor": best_tree
}

predictions = {
    "Linear Regression": linear_pred,
    "Ridge Regression": ridge_pred,
    "Decision Tree Regressor": tree_pred
}

best_model_name = results.loc[0, "Model"]
best_model = model_objects[best_model_name]
best_pred = predictions[best_model_name]

print("Best model:", best_model_name)
print(f"Lowest test RMSE: {results.loc[0, 'RMSE']:.4f}")"""),

M("""## 14. MAE and RMSE Comparison"""),
C("""x = np.arange(len(results))
width = 0.35

plt.figure(figsize=(10, 6))
plt.bar(x - width/2, results["MAE"], width, label="MAE")
plt.bar(x + width/2, results["RMSE"], width, label="RMSE")
plt.xticks(x, results["Model"], rotation=15)
plt.ylabel("Error")
plt.title("MAE and RMSE Comparison")
plt.legend()
plt.tight_layout()
plt.show()"""),

M("""## 15. R² Comparison"""),
C("""plt.figure(figsize=(10, 6))
plt.bar(results["Model"], results["R2"])
plt.ylabel("R² Score")
plt.title("R² Score Comparison")
plt.xticks(rotation=15)
plt.tight_layout()
plt.show()"""),

M("""## 16. Actual vs Predicted — Best Model"""),
C("""plt.figure(figsize=(8, 6))
plt.scatter(y_test, best_pred, alpha=0.5)

low = min(y_test.min(), best_pred.min())
high = max(y_test.max(), best_pred.max())
plt.plot([low, high], [low, high], linestyle="--")

plt.xlabel("Actual House Value")
plt.ylabel("Predicted House Value")
plt.title(f"Actual vs Predicted — {best_model_name}")
plt.tight_layout()
plt.show()"""),

M("""## 17. Residual Analysis"""),
C("""residuals = y_test - best_pred

plt.figure(figsize=(9, 6))
plt.scatter(best_pred, residuals, alpha=0.5)
plt.axhline(0, linestyle="--")
plt.xlabel("Predicted Values")
plt.ylabel("Residuals")
plt.title(f"Residual Plot — {best_model_name}")
plt.tight_layout()
plt.show()

print(f"Residual mean: {residuals.mean():.6f}")"""),

M("""## 18. Decision Tree Feature Importance"""),
C("""feature_importance = pd.Series(
    best_tree.feature_importances_,
    index=X.columns
).sort_values(ascending=False)

display(feature_importance.to_frame("Importance"))

plt.figure(figsize=(10, 6))
feature_importance.sort_values().plot(kind="barh")
plt.xlabel("Importance")
plt.title("Decision Tree Feature Importance")
plt.tight_layout()
plt.show()"""),

M("""## 19. Save the Best Model"""),
C("""os.makedirs("../models", exist_ok=True)
model_path = "../models/best_model.pkl"

joblib.dump(best_model, model_path)
print(f"Best model saved to: {model_path}")"""),

M("""## 20. Final Conclusion

This Task 2 workflow covers:
- Exploratory Data Analysis
- Feature Engineering
- Feature Scaling
- Linear Regression
- Ridge Regression with GridSearchCV
- Decision Tree Regression with GridSearchCV
- MAE, RMSE and R² evaluation
- Model comparison
- Actual vs Predicted visualization
- Residual analysis
- Feature importance
- Model saving

The final best model is selected using the **lowest test RMSE**."""),

M("""## Author

**K M Jeevan Prakash**  
B.Tech — Artificial Intelligence & Machine Learning""")
]

